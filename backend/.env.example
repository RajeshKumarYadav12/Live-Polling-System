# ── Local Development ──────────────────────────────
PORT=5000
MONGODB_URI=mongodb://localhost:27017/live-polling
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ── Production (Render Dashboard → Environment tab) ─
# PORT is set automatically by Render, do NOT hardcode
# MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/live-polling
# NODE_ENV=production
# FRONTEND_URL=https://your-app.vercel.app
