# ── Local Development ─────────────────────────────────────────────────────────
# Leave VITE_API_URL empty — Vite dev-server proxy forwards /api → localhost:5000
# (see vite.config.js proxy config)
VITE_API_URL=
VITE_SOCKET_URL=http://localhost:5000

# ── Production (set these in Vercel dashboard → Settings → Environment Variables)
# Replace with your actual Render backend URL after deploying the backend.
# VITE_API_URL=https://live-polling-backend.onrender.com
# VITE_SOCKET_URL=https://live-polling-backend.onrender.com
